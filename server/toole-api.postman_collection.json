      "item": [
        { "name": "POST login (public)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = (typeof res !== 'undefined' && res.getBody) ? res.getBody() : pm.response.json();", "const data = body && body.data;", "const setVar = (k, v) => (typeof bru !== 'undefined' ? bru.setVar(k, v) : pm.collectionVariables.set(k, v));", "if (data && (data.accessToken || data.token)) setVar('adminToken', data.accessToken || data.token);"] } }], "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@toole.bf\",\n  \"password\": \"motdepasse\"\n}" }, "url": { "raw": "{{baseUrl}}/admin/login", "host": ["{{baseUrl}}"], "path": ["admin", "login"] }, "description": "Renvoie un token admin. Le script Post-Response enregistre automatiquement {{adminToken}}." } },
