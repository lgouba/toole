        { "name": "GET track/:token", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/track/{{trackToken}}", "host": ["{{baseUrl}}"], "path": ["track", "{{trackToken}}"] }, "description": "Suivi public d'une course (lien destinataire)." } }
