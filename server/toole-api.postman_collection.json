{
  "info": {
    "name": "Toolé API",
    "description": "Collection complète de l'API Toolé (Express). Base: {{baseUrl}} = https://api.toole.qalitylabs.fr/api\n\nAuth: la plupart des routes exigent un JWT. Récupère-le via Auth > verify-otp (OTP test 1234 en mode dev) et mets-le dans la variable {{token}}. Pour l'admin, Admin > login puis {{adminToken}}.\n\nVariables à renseigner: token, adminToken, deliveryId, userId, transactionId, promoId, trackToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [
    { "key": "baseUrl", "value": "https://api.toole.qalitylabs.fr/api" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "deliveryId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "transactionId", "value": "" },
    { "key": "promoId", "value": "" },
    { "key": "trackToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST send-otp",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"22651631515\",\n  \"channel\": \"sms\",\n  \"purpose\": \"login\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/send-otp", "host": ["{{baseUrl}}"], "path": ["auth", "send-otp"] }
          }
        },
        {
          "name": "POST verify-otp",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = (typeof res !== 'undefined' && res.getBody) ? res.getBody() : pm.response.json();",
                  "const data = body && body.data;",
                  "const setVar = (k, v) => (typeof bru !== 'undefined' ? bru.setVar(k, v) : pm.collectionVariables.set(k, v));",
                  "if (data && data.accessToken) {",
                  "  setVar('token', data.accessToken);",
                  "  if (data.refreshToken) setVar('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"22651631515\",\n  \"code\": \"1234\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth", "verify-otp"] },
            "description": "Renvoie accessToken + refreshToken. Le script Post-Response enregistre automatiquement {{token}} et {{refreshToken}}."
          }
        },
        {
          "name": "POST register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"22670000009\",\n  \"code\": \"1234\",\n  \"channel\": \"sms\",\n  \"firstName\": \"Aminata\",\n  \"lastName\": \"Ouedraogo\",\n  \"dateOfBirth\": \"1995-06-15\",\n  \"userType\": \"client\",\n  \"referralCode\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Pour un livreur: userType=driver + vehicleType, cnibPhotoUrl, cnibPhotoBackUrl, licensePhotoUrl (URLs issues de POST /uploads/kyc)."
          }
        },
        {
          "name": "POST refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "GET me", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] } } },
        { "name": "PUT me", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Nouveau Nom\",\n  \"email\": \"test@example.com\",\n  \"avatarUrl\": null\n}" }, "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] } } },
        { "name": "DELETE me", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] } } },
        { "name": "POST push-token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"ExponentPushToken[xxxxxxxx]\",\n  \"platform\": \"android\"\n}" }, "url": { "raw": "{{baseUrl}}/users/push-token", "host": ["{{baseUrl}}"], "path": ["users", "push-token"] } } },
        { "name": "DELETE push-token", "request": { "method": "DELETE", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"ExponentPushToken[xxxxxxxx]\"\n}" }, "url": { "raw": "{{baseUrl}}/users/push-token", "host": ["{{baseUrl}}"], "path": ["users", "push-token"] } } }
      ]
    },
    {
      "name": "Drivers",
      "item": [
        { "name": "GET nearby", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/drivers/nearby?lat=12.3714&lng=-1.5197", "host": ["{{baseUrl}}"], "path": ["drivers", "nearby"], "query": [{ "key": "lat", "value": "12.3714" }, { "key": "lng", "value": "-1.5197" }] } } },
        { "name": "GET map (public)", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/drivers/map", "host": ["{{baseUrl}}"], "path": ["drivers", "map"] } } },
        { "name": "PUT status (driver)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"isOnline\": true\n}" }, "url": { "raw": "{{baseUrl}}/drivers/status", "host": ["{{baseUrl}}"], "path": ["drivers", "status"] } } },
        { "name": "PUT location (driver)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"latitude\": 12.3714,\n  \"longitude\": -1.5197\n}" }, "url": { "raw": "{{baseUrl}}/drivers/location", "host": ["{{baseUrl}}"], "path": ["drivers", "location"] } } },
        { "name": "GET me/kyc (driver)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/drivers/me/kyc", "host": ["{{baseUrl}}"], "path": ["drivers", "me", "kyc"] } } },
        { "name": "PUT me/kyc (driver)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"vehicleType\": \"moto\",\n  \"vehiclePlate\": \"11 AB 1234\",\n  \"cnibNumber\": \"B1234567\",\n  \"cnibPhotoUrl\": \"https://.../recto.jpg\",\n  \"cnibPhotoBackUrl\": \"https://.../verso.jpg\",\n  \"licenseNumber\": \"\",\n  \"licensePhotoUrl\": \"\"\n}" }, "url": { "raw": "{{baseUrl}}/drivers/me/kyc", "host": ["{{baseUrl}}"], "path": ["drivers", "me", "kyc"] } } },
        { "name": "GET me/stats (driver)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/drivers/me/stats", "host": ["{{baseUrl}}"], "path": ["drivers", "me", "stats"] } } },
        { "name": "GET :id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/drivers/{{userId}}", "host": ["{{baseUrl}}"], "path": ["drivers", "{{userId}}"] } } }
      ]
    },
    {
      "name": "Deliveries",
      "item": [
        { "name": "GET estimate (public)", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/deliveries/estimate?packageType=small&packageSize=medium&pickupLat=12.3714&pickupLng=-1.5197&deliveryLat=12.3950&deliveryLng=-1.4900", "host": ["{{baseUrl}}"], "path": ["deliveries", "estimate"], "query": [{ "key": "packageType", "value": "small" }, { "key": "packageSize", "value": "medium" }, { "key": "pickupLat", "value": "12.3714" }, { "key": "pickupLng", "value": "-1.5197" }, { "key": "deliveryLat", "value": "12.3950" }, { "key": "deliveryLng", "value": "-1.4900" }] } } },
        { "name": "POST create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"packageType\": \"small\",\n  \"packageCategory\": \"meal\",\n  \"packageSize\": \"medium\",\n  \"packageDescription\": \"Repas\",\n  \"isFragile\": false,\n  \"recipientName\": \"Awa Test\",\n  \"recipientPhone\": \"22670000000\",\n  \"pickupAddress\": \"Point retrait\",\n  \"pickupLat\": 12.3714,\n  \"pickupLng\": -1.5197,\n  \"deliveryAddress\": \"Point livraison\",\n  \"deliveryLat\": 12.3950,\n  \"deliveryLng\": -1.4900,\n  \"paymentMethod\": \"cash\"\n}" }, "url": { "raw": "{{baseUrl}}/deliveries", "host": ["{{baseUrl}}"], "path": ["deliveries"] }, "description": "Optionnels: declaredValue, promoCode, senderContactName/Phone (colis détenu par un tiers), scheduledFor (ISO), pickupDetails, deliveryDetails." } },
        { "name": "GET list", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/deliveries?role=sender&status=", "host": ["{{baseUrl}}"], "path": ["deliveries"], "query": [{ "key": "role", "value": "sender", "description": "sender | driver" }, { "key": "status", "value": "", "description": "optionnel" }] } } },
        { "name": "GET :id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}"] } } },
        { "name": "GET :id/route", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/route", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "route"] } } },
        { "name": "PUT :id/accept (driver)", "request": { "method": "PUT", "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/accept", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "accept"] } } },
        { "name": "PUT :id/reject (driver)", "request": { "method": "PUT", "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/reject", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "reject"] } } },
        { "name": "PUT :id/pickup-confirm (driver)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"photoUrl\": \"https://.../pickup.jpg\",\n  \"pickupCode\": \"1234\"\n}" }, "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/pickup-confirm", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "pickup-confirm"] } } },
        { "name": "PUT :id/validate-code (driver)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"1234\"\n}" }, "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/validate-code", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "validate-code"] } } },
        { "name": "PUT :id/cancel", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Annulation test\"\n}" }, "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/cancel", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "cancel"] } } },
        { "name": "PUT :id/relaunch", "request": { "method": "PUT", "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/relaunch", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "relaunch"] } } },
        { "name": "POST :id/rate", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"score\": 5,\n  \"comment\": \"Parfait\"\n}" }, "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/rate", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "rate"] } } },
        { "name": "GET :id/messages", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/messages", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "messages"] } } },
        { "name": "GET :id/messages/unread", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/messages/unread", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "messages", "unread"] } } },
        { "name": "POST :id/messages", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"content\": \"Bonjour, je suis en route\"\n}" }, "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/messages", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "messages"] } } },
        { "name": "POST :id/messages/read", "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/deliveries/{{deliveryId}}/messages/read", "host": ["{{baseUrl}}"], "path": ["deliveries", "{{deliveryId}}", "messages", "read"] } } }
      ]
    },
